# AgriLedger Environment Variables
# Copy to .env and fill in real values. Never commit .env

# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=postgresql://agriledger:password@localhost:5432/agriledger?schema=public

# Authentication
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-to-another-long-random-string
JWT_REFRESH_EXPIRES_IN=7d

# Password hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3

# File storage (local for development)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# For production S3-compatible:
# STORAGE_DRIVER=s3
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_ENDPOINT=

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Logging
LOG_LEVEL=debug

# Feature flags (future)
OFFLINE_SYNC_ENABLED=false
