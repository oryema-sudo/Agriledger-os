{
  "name": "agriledger",
  "version": "0.1.0",
  "description": "Agricultural Working-Capital Control Platform",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build || tsc -p tsconfig.json || echo 'Build tooling pending full install'",
    "start": "nest start || node dist/main.js || echo 'Start pending'",
    "start:dev": "nest start --watch || ts-node src/main.ts || echo 'Dev start pending'",
    "lint": "eslint \"{src,tests}/**/*.ts\" --fix || echo 'ESLint not fully configured yet – Phase 1'",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" || true",
    "test": "jest || echo 'No tests implemented yet – critical financial tests arrive in Phase 1+'",
    "test:watch": "jest --watch || true",
    "test:cov": "jest --coverage || true",
    "prisma:generate": "prisma generate || true",
    "prisma:migrate": "prisma migrate dev || true"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@prisma/client": "^5.20.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.14.0",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.0",
    "jest": "^29.7.0",
    "prettier": "^3.3.0",
    "prisma": "^5.20.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.5.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=20"
  }
}
