// AgriLedger Prisma schema – Phase 0 design (not yet generated / migrated)
// Full implementation in Phase 1.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Core multi-tenant & identity ---

model Organization {
  id                String   @id @default(uuid())
  name              String
  legalName         String?
  registrationNumber String?
  country           String?
  timezone          String   @default("Africa/Kampala")
  defaultCurrency   String   @default("UGX")
  status            String   @default("ACTIVE") // ACTIVE | SUSPENDED | ARCHIVED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  members           OrganizationMember[]
  suppliers         Supplier[]
  agents            Agent[]
  // ... other relations added in Phase 1+
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  phone        String?
  status       String   @default("INVITED") // INVITED | ACTIVE | DISABLED
  lastLoginAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships  OrganizationMember[]
}

model OrganizationMember {
  id             String   @id @default(uuid())
  organizationId String
  userId         String
  role           String   // Owner | FinanceManager | ... (or FK to Role)
  status         String   @default("ACTIVE")
  joinedAt       DateTime @default(now())

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([organizationId])
}

// --- Domain entities (simplified for Phase 0; expanded in Phase 1/2) ---

model Supplier {
  id               String   @id @default(uuid())
  organizationId   String
  code             String?
  name             String
  phone            String?
  status           String   @default("ACTIVE")
  // openingBalanceMinor BigInt @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@unique([organizationId, code])
}

model Agent {
  id               String   @id @default(uuid())
  organizationId   String
  code             String?
  name             String
  phone            String?
  status           String   @default("ACTIVE")
  // currentFloatMinor BigInt @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  organization     Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

// Placeholder for other models (ProcurementTransaction, PaymentRecord,
// ReconciliationRecord, Sale, Invoice, Document, AuditLog, etc.)
// See docs/DATABASE.md for the full intended model.
